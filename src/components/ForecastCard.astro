---
// DESIGN §4.4: hairline card, label left, big serif value right.
import { arrow, direction, percent } from '../lib/format';

interface Props {
  label: string;
  value: string;
  unit?: string;
  meta?: string;
  /** change vs today's price as a fraction; shows ▲/▼ and a colored % */
  change?: number | null;
}

const { label, value, unit = 'per troy ounce', meta, change } = Astro.props;
const dir = direction(change);
---

<div class="fcard">
  <div class="fcard__left">
    <div class="fcard__label">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M2 14l5-5 3 3 7-7M12 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {label}
    </div>
    {meta && <div class="meta">{meta}</div>}
  </div>
  <div class="fcard__right">
    <div class="big-number">{value}</div>
    <div class="meta">
      {unit}
      {change != null && <span class={`fcard__chg ${dir}`}> · {arrow(change)} {percent(change)}</span>}
    </div>
  </div>
</div>

<style>
  .fcard {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 8px 16px;
    border: var(--hairline) solid var(--slate-500);
    border-radius: var(--radius);
  }
  :global(.section--dark) .fcard {
    border-color: var(--gray-300);
  }
  .fcard__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    letter-spacing: normal;
  }
  .fcard__right {
    text-align: right;
  }
  .fcard__right .big-number {
    white-space: nowrap;
  }
  .fcard__chg {
    font-weight: 500;
    white-space: nowrap;
  }
  @media (max-width: 400px) {
    .fcard__right .big-number {
      font-size: 26px;
    }
  }
</style>
