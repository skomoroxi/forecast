---
// DESIGN §4.2: sticky white navbar with asset dropdowns.
import { assets, assetUrl } from '../lib/assets';
import { headings } from '../lib/assetContent';

const groups = Object.entries(
  assets.reduce<Record<string, typeof assets>>((acc, a) => {
    (acc[a.group] ??= []).push(a);
    return acc;
  }, {}),
);
const primary = assets.find((a) => a.enabled);
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="nav__inner container">
    <a class="wordmark" href="/" aria-label="FinForecast home">FinForecast</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="nav-menu" class="nav__menu" aria-label="Main">
      <ul class="nav__links">
        {
          groups.map(([group, list]) => (
            <li class="dropdown">
              <button class="dropdown__btn" type="button" aria-expanded="false">
                {group}
                <svg class="chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </button>
              <ul class="dropdown__menu">
                {list.map((a) => (
                  <li>
                    {a.enabled ? (
                      <a href={assetUrl(a)} aria-current={path === assetUrl(a) ? 'page' : undefined}>
                        {headings(a, { run: 0, last: 0 }).og}
                      </a>
                    ) : (
                      <span class="disabled">
                        {a.name} <em>soon</em>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
        <li><a href="/methodology/" aria-current={path === '/methodology/' ? 'page' : undefined}>Methodology</a></li>
        <li><a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a></li>
      </ul>
      {primary && <a class="btn btn--primary nav__cta" href={assetUrl(primary)}>{primary.name} forecast</a>}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });

  const dropdowns = document.querySelectorAll<HTMLButtonElement>('.dropdown__btn');
  dropdowns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      dropdowns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    }),
  );
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.dropdown')) dropdowns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dropdowns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: var(--hairline) solid var(--gray-200);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
  }
  .wordmark,
  .wordmark:visited {
    font-family: var(--font-serif);
    font-size: 26px;
    letter-spacing: -0.5px;
    color: var(--navy-900);
    text-decoration: none;
  }
  .nav__menu {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links > li > a,
  .nav__links > li > a:visited,
  .dropdown__btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--navy-900);
    font: 400 16px/1.2 var(--font-sans);
    letter-spacing: normal;
    text-decoration: none;
    background: none;
    border: 0;
    padding: 8px 0;
    cursor: pointer;
  }
  .nav__links a:hover,
  .dropdown__btn:hover {
    color: var(--accent);
  }
  .nav__links a[aria-current='page'] {
    color: var(--accent);
  }
  .chev {
    transition: transform 0.2s;
  }
  .dropdown {
    position: relative;
  }
  .dropdown__btn[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  .dropdown__menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: -16px;
    min-width: 230px;
    margin: 0;
    padding: 8px 0;
    list-style: none;
    background: var(--white);
    border: var(--hairline) solid var(--gray-200);
    border-radius: var(--radius-widget);
    box-shadow: 0 8px 24px rgb(24 29 39 / 0.08);
  }
  .dropdown__btn[aria-expanded='true'] + .dropdown__menu {
    display: block;
  }
  .dropdown__menu a,
  .dropdown__menu a:visited,
  .dropdown__menu .disabled {
    display: block;
    padding: 8px 16px;
    color: var(--navy-900);
    text-decoration: none;
    font-size: 15px;
    letter-spacing: normal;
  }
  .dropdown__menu a:hover {
    background: var(--gray-50);
  }
  .disabled {
    color: var(--muted) !important;
  }
  .disabled em {
    font-style: normal;
    font-size: 12px;
    margin-left: 4px;
    padding: 1px 6px;
    border: var(--hairline) solid var(--gray-300);
    border-radius: 10px;
  }
  .nav__cta {
    align-self: stretch;
    margin: 0;
    border-radius: 0;
    padding: 0 24px;
  }
  .nav__toggle {
    display: none;
  }

  @media (max-width: 991px) {
    .nav__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      background: none;
      border: 0;
      cursor: pointer;
    }
    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 22px;
      height: 1.5px;
      background: var(--navy-900);
      position: relative;
      transition: transform 0.2s;
    }
    .bars::before,
    .bars::after {
      content: '';
      position: absolute;
    }
    .bars::before {
      top: -7px;
    }
    .bars::after {
      top: 7px;
    }
    .nav__toggle[aria-expanded='true'] .bars {
      background: transparent;
    }
    .nav__toggle[aria-expanded='true'] .bars::before {
      transform: translateY(7px) rotate(45deg);
    }
    .nav__toggle[aria-expanded='true'] .bars::after {
      transform: translateY(-7px) rotate(-45deg);
    }
    .nav__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--nav-h));
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      height: auto;
      padding: 24px var(--gutter);
      background: var(--white);
      overflow-y: auto;
    }
    .nav__menu.open {
      display: flex;
    }
    .nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav__links > li {
      border-bottom: var(--hairline) solid var(--gray-200);
    }
    .nav__links > li > a,
    .dropdown__btn {
      width: 100%;
      justify-content: space-between;
      padding: 16px 0;
      font-size: 18px;
    }
    .dropdown__menu {
      position: static;
      border: 0;
      box-shadow: none;
      padding: 0 0 12px;
    }
    .nav__cta {
      align-self: stretch;
      border-radius: var(--radius);
      min-height: 48px;
    }
  }
</style>
