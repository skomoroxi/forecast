---
// DESIGN §4.10: <details> accordion (works without JS, fully indexable) + FAQPage JSON-LD.
interface Props {
  id?: string;
  heading?: string;
  items: { q: string; a: string }[];
  /** emit FAQPage structured data from the same items */
  schema?: boolean;
}

const { id = 'faq', heading = 'Frequently asked questions', items, schema = true } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<section id={id} class="section section--faq">
  <div class="container">
    <h2 class="faq__title">{heading}</h2>
    <div class="faq">
      {
        items.map((i) => (
          <details class="faq__item">
            <summary>
              <span>{i.q}</span>
              <svg class="chev" viewBox="0 0 12 12" width="14" height="14" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </summary>
            <p>{i.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</section>

<style>
  .faq__title {
    letter-spacing: -2px;
    margin-bottom: 16px;
  }
  .faq__item {
    border-bottom: var(--hairline) solid var(--gray-250);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: normal;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    flex: none;
    transition: transform 0.2s;
  }
  details[open] .chev {
    transform: rotate(180deg);
  }
  .faq__item p {
    margin: -12px 0 24px;
    max-width: 820px;
  }
</style>
